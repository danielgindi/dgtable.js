{
  "name": "@danielgindi/dgtable.js",
  "description": "High-performance table View for vanilla JS",
  "version": "2.0.38",
  "main": "dist/lib.cjs.min.cjs",
  "module": "dist/lib.es6.min.js",
  "browser": "dist/lib.umd.min.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/lib.es6.min.js",
      "require": "./dist/lib.cjs.min.cjs",
      "default": "./dist/lib.es6.min.js"
    },
    "./package.json": "./package.json"
  },
  "author": {
    "name": "Daniel Cohen Gindi",
    "email": "danielgindi@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/danielgindi/dgtable.js.git"
  },
  "scripts": {
    "build": "npm run lint && node ./scripts/build.js",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "lint": "node -e \"process.env.NODE_ENV != 'production' && process.exit(1)\" || eslint -f codeframe ./",
    "lint-fix": "node -e \"process.env.NODE_ENV != 'production' && process.exit(1)\" || eslint -f codeframe --fix ./",
    "prepare": "node -e \"process.env.NODE_ENV != 'production' && process.exit(1)\" || husky",
    "prepublishOnly": "node -e \"process.env.NODE_ENV != 'production' && process.exit(1)\" || npm run build",
    "test": "vitest run --project unit --project \"browser*\" --project types",
    "test:watch": "vitest --project unit --project \"browser*\"",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project \"browser*\"",
    "test:types": "vitest run --project types",
    "test:dist": "npm run build && vitest run --project dist --project package",
    "test:perf": "vitest run --project perf",
    "test:coverage": "vitest run --project unit --project \"browser (chromium)\" --coverage"
  },
  "bugs": {
    "url": "https://github.com/danielgindi/dgtable.js/issues"
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/danielgindi/dgtable.js/blob/master/LICENSE"
    }
  ],
  "dependencies": {
    "@danielgindi/dom-utils": "^1.0.11",
    "@danielgindi/virtual-list-helper": "^1.0.19",
    "mitt": "^3.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "core-js": "^3.50.0",
    "eslint": "^9.39.5",
    "eslint-formatter-codeframe": "^7.32.2",
    "fast-check": "^4.10.2",
    "fs-extra": "^11.4.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "pinst": "^3.0.0",
    "playwright": "^1.63.0",
    "rollup": "^4.64.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
